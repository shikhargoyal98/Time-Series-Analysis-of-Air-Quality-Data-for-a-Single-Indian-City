{"code":"/*\n *\n * Task code generated by SAS Studio 3.8 \n *\n * Generated on '2/27/25, 4:26 PM' \n * Generated by 'shg23026' \n * Generated on server 'CTX-VDA-MSB-B03.GROVE.AD.UCONN.EDU' \n * Generated on SAS platform 'X64_SRV19 WIN' \n * Generated on SAS version '9.04.01M7P08052020' \n * Generated on browser 'Mozilla/5.0 (Windows NT 10.0; WOW64; Trident/7.0; rv:11.0) like Gecko' \n * Generated on web client 'http://localhost:53439/main?locale=en_US&zone=GMT-05%253A00&sutoken=%257B50E1352E-2114-432D-8936-E18C9828BF4E%257D' \n *\n */\n\nods noproctitle;\nods graphics / imagemap=on;\n\nproc sort data=WORK.IMPORT out=Work.preProcessedData;\n\tby 'From Date'n;\nrun;\n\n** Step 1: Run ARIMAX Model and Store Forecasts **;\nproc arima data=Work.preProcessedData plots\n     (only)=(series(corr crosscorr) residual(corr normal) \n\t\tforecast(forecast forecastonly) );\n\tidentify var='PM2.5 (ug/m3)'n crosscorr=('PM10 (ug/m3)'n 'AT (degree C)'n) \n\t\toutcov=work.outcov;\n\testimate p=(1) input=('PM10 (ug/m3)'n 'AT (degree C)'n) method=ML \n\t\toutest=work.outest outstat=work.outstat outmodel=work.outmodel;\n\tforecast lead=12 back=0 alpha=0.05 id='From Date'n interval=day printall\n\t\tout=work.forecast_results;  /* Store forecast results */\n\toutlier;\nrun;\nquit;\n\n** Step 2: Merge Actual Values with Forecasted Data **;\nproc sort data=work.forecast_results; by 'From Date'n; run;\nproc sort data=work.preProcessedData; by 'From Date'n; run;\n\ndata work.forecast_results;\n   merge work.forecast_results (in=a) \n         work.preProcessedData (in=b keep='From Date'n 'PM2.5 (ug/m3)'n rename=('PM2.5 (ug/m3)'n=actual));\n   by 'From Date'n;\n   if a; /* Keep only forecasted data */\nrun;\n\n** Step 3: Compute Forecast Errors **;\ndata work.forecast_results;\n   set work.forecast_results;\n   error = actual - forecast; /* Forecast error */\n   abs_error = abs(error); /* Absolute Error */\n   squared_error = error**2; /* Squared Error */\n   percentage_error = abs(error) / actual * 100; /* Percentage Error */\nrun;\n\n** Step 4: Compute MAE, RMSE, and MAPE **;\nproc means data=work.forecast_results mean std;\n   var abs_error squared_error percentage_error;\n   output out=work.accuracy_results mean(abs_error)=MAE \n          std(error)=RMSE /* Calculate RMSE as standard deviation of error */\n          mean(percentage_error)=MAPE;\nrun;\n\n** Step 5: Display Accuracy Metrics **;\nproc print data=work.accuracy_results;\nrun;\n\nproc delete data=Work.preProcessedData;\nrun;\n","log":"<div charset=\"UTF-8\" {'style':display:none;height:0px'}=\"\"></div><div {'style':display:none;height:0px'}=\"\" href=\"./log.css\" rel=\"stylesheet\"></div><style rel=\"stylesheet\">.sasError {color: red;}.sasMessage{color:#000000;}.sasWarning{color:green;}.sasSource{color:#000000;}.sasNote {color:blue;}</style><div div=\"\" {'style':display:none;height:0px'}log:program=\"\" 2<=\"\"><pre class=\"sasLog\" id=\"pre_sasLog_9\" style=\"border-top-width: 0px; border-bottom-width: 0px; background-color: transparent; -webkit-touch-callout: default; -webkit-user-select: text; -webkit-user-modify: read-only;\"><div><div class=\"sasSource\"> </div><div class=\"sasSource\"> 1          OPTIONS NONOTES NOSTIMER NOSOURCE NOSYNTAXCHECK;</div><div class=\"sasNote\" id=\"sasLogNote1_1740691759821\"> NOTE: ODS statements in the SAS Studio environment may disable some output features.</div><div class=\"sasSource\"> 73         </div><div class=\"sasSource\"> 74         /*</div><div class=\"sasSource\"> 75          *</div><div class=\"sasSource\"> 76          * Task code generated by SAS Studio 3.8</div><div class=\"sasSource\"> 77          *</div><div class=\"sasSource\"> 78          * Generated on '2/27/25, 4:26 PM'</div><div class=\"sasSource\"> 79          * Generated by 'shg23026'</div><div class=\"sasSource\"> 80          * Generated on server 'CTX-VDA-MSB-B03.GROVE.AD.UCONN.EDU'</div><div class=\"sasSource\"> 81          * Generated on SAS platform 'X64_SRV19 WIN'</div><